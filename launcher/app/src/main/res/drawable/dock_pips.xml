    <item android:left="0dp" android:width="4dp" android:height="4dp">
        <shape android:shape="oval"><solid android:color="?attr/dmAccent" /></shape>
    </item>
    <item android:left="10dp" android:width="4dp" android:height="4dp">
        <shape android:shape="oval"><solid android:color="?attr/dmAccent" /></shape>
    </item>
    <item android:left="20dp" android:width="4dp" android:height="4dp">
        <shape android:shape="oval"><solid android:color="?attr/dmAccent" /></shape>
    </item>
</layer-list>
