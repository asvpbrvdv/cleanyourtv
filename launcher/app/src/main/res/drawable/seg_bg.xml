<?xml version="1.0" encoding="utf-8"?>
<!-- A top-bar segment: filled with ink when focused, or while its popup is open (selected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dmInk" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dmInk" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
