<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/space_mono"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Under the focused grid tile: an accent dot, then the name in capitals. Width and top set in AppAdapter. -->
    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:translationY="-6dp"
        android:drawableStart="@drawable/name_dot"
        android:drawablePadding="7dp"
        android:textColor="?attr/dmInk"
        android:textSize="11sp"
        android:fontFamily="@font/space_mono"
        android:letterSpacing="0.14"
        android:textAllCaps="true" />

    <!-- Under the focused dock tile: three accent pips. Top set in AppAdapter. -->
    <View
        android:id="@+id/pips"
        android:layout_width="24dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="115dp"
        android:alpha="0"
        android:background="@drawable/dock_pips"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
